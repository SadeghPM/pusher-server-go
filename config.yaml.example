port: "6001"
metrics_port: "9601"
dashboard_port: "5174"
host: "https://pusher.example.com"
# Replace with a long random value (e.g. `openssl rand -hex 24`).
# Placeholder values are rejected on startup.
admin_token: "REPLACE_WITH_A_LONG_RANDOM_TOKEN"
# Only needed when the dashboard is behind a reverse proxy you control.
# trusted_proxies: ["127.0.0.1/32", "::1/128"]
debug: false
apps:
  - app_id: "my-app-id-1"
    app_key: "my-app-key-1"
    app_secret: "my-app-secret-1"
    allowed_origins: ["*"]
    webhooks: []
  - app_id: "my-app-id-2"
    app_key: "my-app-key-2"
    app_secret: "my-app-secret-2"
    allowed_origins: ["http://localhost:3000", "https://example.com"]
    webhooks: ["https://example.com/pusher/webhook"]
